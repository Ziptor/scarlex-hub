[Unit]
Description=Scarlex Telegram Bot (@scarlex_bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scarlex
Group=scarlex
WorkingDirectory=/opt/scarlex-bot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/scarlex-bot/.env
ExecStart=/opt/scarlex-bot/venv/bin/python /opt/scarlex-bot/bot.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/scarlex-bot/bot.log
StandardError=append:/var/log/scarlex-bot/bot.err.log

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/scarlex-bot
ProtectHome=true

[Install]
WantedBy=multi-user.target
