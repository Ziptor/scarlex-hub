# ──────────────────────────────────────────────────
# Kiro Proxy — Environment Configuration
# ──────────────────────────────────────────────────

# API key для доступа к прокси (Bearer token)
# Если пустой — авторизация отключена
KIRO_API_KEY=your-secret-api-key-here

# Порт сервера (за nginx на 127.0.0.1)
KIRO_PORT=8000

# Путь к accounts.json
KIRO_ACCOUNTS_FILE=/opt/kiro-proxy/accounts.json

# Интервал проверки здоровья аккаунтов (секунды)
# 900 = 15 мин, 1200 = 20 мин
KIRO_HEALTH_INTERVAL=900

# Python IO encoding
PYTHONIOENCODING=utf-8
